# Simple static redirects for email tracking
# Note: Redirects are broken in this Netlify deployment, so using direct URLs instead

# Test redirect (for debugging)
/test-redirect /pixel.html 200

# Direct pixel tracking (no redirects needed - using query parameters)
# All tracking now goes directly to /pixel.html?id=TRACKING_ID

# Click tracking (still needs redirects)
/track/click/:id /track/click/?trackingId=:id 200
