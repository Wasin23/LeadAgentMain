# Meridian Production Configuration Example
# Copy this file to .env and update with your actual values

# =================================
# Server Configuration
# =================================
NODE_ENV=production
API_PORT=8080
HOST=0.0.0.0

# =================================
# Security Configuration
# =================================
SESSION_SECRET=your-very-secure-session-secret-here-change-this
ADMIN_KEY=your-admin-access-key-here
CORS_ORIGIN=https://yourdomain.com

# =================================
# Rate Limiting
# =================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =================================
# Logging Configuration
# =================================
LOG_LEVEL=info

# =================================
# Performance Configuration
# =================================
REQUEST_TIMEOUT=30000
REQUEST_SIZE_LIMIT=10mb
COMPRESSION_LEVEL=6

# =================================
# API Keys (Required)
# =================================
OPENAI_API_KEY=your-openai-api-key
SERPER_API_KEY=your-serper-api-key

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain

# Email Tracking
TRACKING_DOMAIN=your-tracking-domain.com

# =================================
# External Services (Optional)
# =================================

# Apollo API
APOLLO_API_KEY=your-apollo-api-key

# ZeroBounce & Hunter.io for email verification
ZEROBOUNCE_API_KEY=your-zerobounce-api-key
HUNTER_API_KEY=your-hunter-api-key

# LinkedIn API
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=your-linkedin-redirect-uri

# HeyReach API
HEYREACH_API_KEY=your-heyreach-api-key
HEYREACH_BASE_URL=your-heyreach-base-url

# =================================
# API Base URL Configuration
# =================================
API_BASE_URL=http://localhost:8080

# =================================
# Vector Database (Zilliz)
# =================================
ZILLIZ_ENDPOINT=your-zilliz-endpoint
ZILLIZ_TOKEN=your-zilliz-token

# =================================
# Database Configuration (if using external DB)
# =================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian
DB_USER=meridian_user
DB_PASSWORD=your-database-password

# =================================
# Monitoring & Backup
# =================================
ENABLE_MONITORING=true
BACKUP_RETENTION_DAYS=30

# =================================
# Development Settings (remove in production)
# =================================
# ELECTRON_IS_DEV=false
