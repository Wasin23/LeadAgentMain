{
  "type": "module",
  "name": "meridian",
  "version": "1.0.0",
  "main": "main.cjs",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node app.js",
    "start:prod": "NODE_ENV=production node app.js",
    "start:monitoring": "ENABLE_MONITORING=true node --expose-gc app.js",
    "electron": "electron .",
    "electron-dev": "set ELECTRON_IS_DEV=true && electron .",
    "electron-dev-unix": "ELECTRON_IS_DEV=true electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "build-all": "electron-builder --win --mac --linux",
    "dist": "npm run build",
    "dist-win": "npm run build-win",
    "pack": "electron-builder --dir",
    "backup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.createFullBackup())\"",
    "backup:cleanup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.cleanupOldBackups())\"",
    "health": "curl -f http://localhost:8080/health || exit 1",
    "desktop:build": "chmod +x build-desktop.sh && ./build-desktop.sh",
    "desktop:build-win": "build-desktop.bat"
  },
  "keywords": [
    "desktop",
    "ai",
    "leads",
    "automation"
  ],
  "author": "Meridian Team",
  "license": "ISC",
  "description": "Meridian - AI-Powered Lead Research & Email Automation Desktop App",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.902.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/credential-providers": "^3.901.0",
    "@aws-sdk/lib-dynamodb": "^3.902.0",
    "@chroma-core/default-embed": "^0.1.8",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.3",
    "@langchain/pinecone": "^0.2.0",
    "@pinecone-database/pinecone": "^6.1.2",
    "@sendgrid/mail": "^8.1.5",
    "@zilliz/milvus2-sdk-node": "^2.6.0",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "chromadb": "^3.0.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.30",
    "mailgun.js": "^12.0.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "openai": "^5.12.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.meridian.desktop",
    "productName": "Meridian",
    "directories": {
      "output": "dist",
      "app": ".",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "app.js",
      "package.json",
      "public/**/*",
      "routes/**/*",
      "src/**/*",
      "tools/**/*",
      "utils/**/*",
      "lib/**/*",
      "agent/**/*",
      "node_modules/**/*",
      "*.json",
      "!node_modules/.cache/**/*",
      "!dist/**/*",
      "!.git/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icons/icon-256x256.png",
      "uninstallerIcon": "public/icons/icon-256x256.png",
      "artifactName": "Meridian-Setup-${version}.${ext}",
      "shortcutName": "Meridian"
    },
    "dmg": {
      "title": "Meridian ${version}",
      "artifactName": "Meridian-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "Meridian-${version}.${ext}"
    }
  }
}
