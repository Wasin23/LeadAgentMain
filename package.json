{
  "type": "module",
  "name": "examark",
  "version": "1.0.0",
  "main": "main.cjs",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=true electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "dist": "npm run build"
  },
  "keywords": ["desktop", "ai", "leads", "automation"],
  "author": "ExaMark Team",
  "license": "ISC",
  "description": "ExaMark - AI-Powered Lead Research & Email Automation Desktop App",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.8",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.3",
    "@langchain/pinecone": "^0.2.0",
    "@pinecone-database/pinecone": "^6.1.2",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "chromadb": "^3.0.10",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "form-data": "^4.0.4",
    "langchain": "^0.3.30",
    "mailgun.js": "^12.0.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "openai": "^5.12.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.0"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.examark.desktop",
    "productName": "ExaMark",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "app.js",
      "package.json",
      "public/**/*",
      "routes/**/*",
      "src/**/*",
      "tools/**/*",
      "utils/**/*",
      "lib/**/*",
      "agent/**/*",
      "node_modules/**/*",
      "*.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-256x256.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/icon-512x512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
