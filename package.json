{
  "type": "module",
  "name": "meridian",
  "version": "1.0.0",
  "main": "main.cjs",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node app.js",
    "start:prod": "NODE_ENV=production node app.js",
    "start:monitoring": "ENABLE_MONITORING=true node --expose-gc app.js",
    "backup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.createFullBackup())\"",
    "backup:cleanup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.cleanupOldBackups())\"",
    "health": "curl -f http://localhost:8080/health || exit 1",
    "dev": "cd moderntask && npm run dev",
    "desktop:build": "echo \"Desktop build disabled (Electron removed)\" && exit 0"
  },
  "keywords": [
    "ai",
    "leads",
    "automation"
  ],
  "author": "Meridian Team",
  "license": "ISC",
  "description": "Meridian - AI-Powered Lead Research & Email Automation Desktop App",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-dynamodb": "^3.902.0",
    "@aws-sdk/client-ses": "^3.901.0",
    "@aws-sdk/credential-providers": "^3.901.0",
    "@aws-sdk/lib-dynamodb": "^3.902.0",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.3",
    "@zilliz/milvus2-sdk-node": "^2.6.0",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "form-data": "^4.0.4",
    "googleapis": "^144.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.30",
    "mailgun.js": "^12.0.3",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "openai": "^5.12.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.16.0",
    "stripe": "^20.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.27"
  }
}
