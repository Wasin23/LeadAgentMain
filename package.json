{
  "type": "module",
  "name": "examark",
  "version": "1.0.0",
  "main": "main.cjs",
  "homepage": "./",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node app.js",
    "start:prod": "NODE_ENV=production node app.js",
    "start:monitoring": "ENABLE_MONITORING=true node --expose-gc app.js",
    "electron": "electron .",
    "electron-dev": "ELECTRON_IS_DEV=true electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "dist": "npm run build",
    "backup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.createFullBackup())\"",
    "backup:cleanup": "node -e \"import('./utils/backup.js').then(m => m.backupManager.cleanupOldBackups())\"",
    "health": "curl -f http://localhost:8080/health || exit 1"
  },
  "keywords": [
    "desktop",
    "ai",
    "leads",
    "automation"
  ],
  "author": "ExaMark Team",
  "license": "ISC",
  "description": "ExaMark - AI-Powered Lead Research & Email Automation Desktop App",
  "dependencies": {
    "@chroma-core/default-embed": "^0.1.8",
    "@langchain/community": "^0.3.49",
    "@langchain/core": "^0.3.66",
    "@langchain/openai": "^0.6.3",
    "@langchain/pinecone": "^0.2.0",
    "@pinecone-database/pinecone": "^6.1.2",
    "@sendgrid/mail": "^8.1.5",
    "@zilliz/milvus2-sdk-node": "^2.6.0",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "chromadb": "^3.0.10",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "langchain": "^0.3.30",
    "mailgun.js": "^12.0.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "openai": "^5.12.0",
    "pg": "^8.16.3",
    "puppeteer": "^24.16.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.examark.desktop",
    "productName": "ExaMark",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "app.js",
      "package.json",
      "public/**/*",
      "routes/**/*",
      "src/**/*",
      "tools/**/*",
      "utils/**/*",
      "lib/**/*",
      "agent/**/*",
      "node_modules/**/*",
      "*.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-256x256.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icons/icon-512x512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
